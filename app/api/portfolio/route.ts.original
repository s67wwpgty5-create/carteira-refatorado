import {getChatGPTUser} from '@/app/chatgpt-auth';
import {bootstrapContacts} from '@/lib/bootstrap';
import {readPortfolio} from '@/lib/portfolio-state';
import {database} from '@/lib/database';
import {datasetSchema} from '@/lib/validation';
import {z} from 'zod';
import {audienceSchema,scheduleSchema} from '@/lib/campaigns';
import seed from '@/lib/seed.json';
export const dynamic='force-dynamic';
const json=(v:unknown,status=200)=>Response.json(v,{status,headers:{'Cache-Control':'no-store'}});
export async function GET(){const u=await getChatGPTUser();if(!u)return json({error:'Entre na sua conta para acessar a carteira.'},401);try{await bootstrapContacts(u);const {activePayload,...state}=await readPortfolio(u.userId);return json(state);}catch{return json({error:'Não foi possível carregar a carteira.'},503);}}
export async function POST(request:Request){const u=await getChatGPTUser();if(!u)return json({error:'Entre na sua conta para salvar.'},401);const origin=request.headers.get('origin');if(origin&&origin!==new URL(request.url).origin)return json({error:'Origem não permitida.'},403);try{const raw=await request.text();if(raw.length>12_000_000)return json({error:'Arquivo grande demais para esta versão.'},413);const {action,payload:p}=JSON.parse(raw);await bootstrapContacts(u);const db=database();const now=new Date().toISOString();const put=(kind:string,id:string,value:unknown)=>db.prepare('INSERT INTO records (owner,kind,id,payload,updated) VALUES (?,?,?,?,?) ON CONFLICT(owner,kind,id) DO UPDATE SET payload=excluded.payload,updated=excluded.updated').bind(u.userId,kind,id,JSON.stringify(value),now);
 const contactSchema=z.object({id:z.string().regex(/^\d+$/),phone:z.string().max(30).refine(s=>!s||/^\+?[\d\s()-]{8,30}$/.test(s),'Telefone inválido'),email:z.union([z.literal(''),z.string().email().max(254)]),owner:z.string().max(150),region:z.string().trim().max(100).optional(),city:z.string().trim().max(100).optional(),commercialPhone:z.string().max(30).optional(),emails:z.array(z.string().email().max(254)).max(100).optional(),phones:z.array(z.string().max(30)).max(100).optional(),contactSource:z.string().max(200).optional(),contactSourceRows:z.array(z.number().int().positive()).max(100).optional(),rawPhones:z.array(z.string().max(2000)).max(100).optional(),rawEmails:z.string().max(10000).optional()});
 if(action==='contact'){const {id,...contact}=contactSchema.parse(p);const old=await db.prepare('SELECT payload FROM records WHERE owner=? AND kind=? AND id=?').bind(u.userId,'contact',id).first<{payload:string}>();await put('contact',id,{...(old?JSON.parse(old.payload):{}),...contact}).run();return json({ok:true});}
 if(action==='contacts-import'){const rows=z.array(contactSchema).max(100).parse(p);if(new Set(rows.map(r=>r.id)).size!==rows.length)return json({error:'Códigos duplicados.'},400);const old=await db.prepare('SELECT id,payload FROM records WHERE owner=? AND kind=?').bind(u.userId,'contact').all<{id:string;payload:string}>();const existing=new Map(old.results.map(r=>[r.id,JSON.parse(r.payload)]));await db.batch(rows.map(({id,...incoming})=>{const previous=existing.get(id)||{};const merged={...incoming,...previous};for(const [key,value] of Object.entries(incoming)){if(!previous[key]||(Array.isArray(previous[key])&&!previous[key].length))merged[key]=value;}return put('contact',id,merged);}));return json({ok:true,count:rows.length});}
 if(action==='audience'){const v=audienceSchema.parse(p);const active=await db.prepare("SELECT payload FROM records WHERE owner=? AND kind='active' AND id='dataset'").bind(u.userId).first<{payload:string}>();let ids:Set<string>;if(active){const rows=await db.prepare('SELECT id FROM imported_clients WHERE batch=?').bind(JSON.parse(active.payload).id).all<{id:string}>();ids=new Set(rows.results.map(r=>r.id));}else ids=new Set(seed.clients.map(c=>c.id));if(v.clients.some(id=>!ids.has(id)))return json({error:'Há clientes que não pertencem à carteira atual.'},400);const audience={...v,id:crypto.randomUUID(),created:now};await put('audience',audience.id,audience).run();return json({audience});}
 if(action==='schedule'){const v=scheduleSchema.parse(p);const row=await db.prepare("SELECT payload FROM records WHERE owner=? AND kind='audience' AND id=?").bind(u.userId,v.audienceId).first<{payload:string}>();if(!row)return json({error:'Público não encontrado.'},404);const audience=JSON.parse(row.payload);const schedule={...v,id:crypto.randomUUID(),clients:audience.clients,audienceName:audience.name,created:now,status:'pending_manual'};await put('schedule',schedule.id,schedule).run();return json({schedule});}
 if(action==='cancel-schedule'){const id=z.string().uuid().parse(p.id);const row=await db.prepare("SELECT payload FROM records WHERE owner=? AND kind='schedule' AND id=?").bind(u.userId,id).first<{payload:string}>();if(!row)return json({error:'Agendamento não encontrado.'},404);const schedule={...JSON.parse(row.payload),status:'cancelled'};await put('schedule',id,schedule).run();return json({schedule});}
 if(action==='activity'){const v=z.object({client:z.string().regex(/^\d+$/),note:z.string().trim().min(1).max(5000),due:z.union([z.literal(''),z.string().regex(/^\d{4}-\d{2}-\d{2}$/)])}).parse(p);const activity={...v,id:crypto.randomUUID(),created:now,done:false};await put('activity',activity.id,activity).run();return json({activity});}
 if(action==='complete'){const id=z.string().uuid().parse(p.id);const old=await db.prepare('SELECT payload FROM records WHERE owner=? AND kind=? AND id=?').bind(u.userId,'activity',id).first<{payload:string}>();if(!old)return json({error:'Atividade não encontrada.'},404);await put('activity',id,{...JSON.parse(old.payload),done:true}).run();return json({ok:true});}
 if(action==='coverage'){await put('coverage','seed',{confirmed:true}).run();return json({ok:true});}
 if(action==='import'){const v=datasetSchema.parse(p);const {clients,...metadata}=v;const hash=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(JSON.stringify(v)));const batch=u.userId+'-'+Array.from(new Uint8Array(hash)).map(b=>b.toString(16).padStart(2,'0')).join('');const found=await db.prepare('SELECT id FROM imports WHERE id=? AND owner=?').bind(batch,u.userId).first();if(!found){for(let i=0;i<clients.length;i+=80)await db.batch(clients.slice(i,i+80).map(c=>db.prepare('INSERT INTO imported_clients (batch,id,payload) VALUES (?,?,?) ON CONFLICT(batch,id) DO UPDATE SET payload=excluded.payload').bind(batch,c.id,JSON.stringify(c))));await db.prepare('INSERT INTO imports (id,owner,metadata,created) VALUES (?,?,?,?) ON CONFLICT(id) DO NOTHING').bind(batch,u.userId,JSON.stringify(metadata),now).run();}await put('active','dataset',{id:batch}).run();return json({ok:true});}
 return json({error:'Operação desconhecida.'},400);
 }catch(e){if(e instanceof z.ZodError)return json({error:'Revise os dados: '+e.issues[0].message},400);console.error('portfolio write failed',e);return json({error:'Não foi possível salvar. Seus dados na tela foram preservados; tente novamente.'},503);}}
